# AgriChem AI Environment Configuration

# Server
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Database
DATABASE_URL=sqlite:///./agrichem.db

# Security & JWT Auth
SECRET_KEY=agrichem-ai-super-secret-key-change-in-production-2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ESP32 Device Auth
ESP32_DEVICE_ID=ESP32-AGRI-01
ESP32_API_KEY=esp32-secure-token-agrichem-2026

# Hardware Safety Interlock
# By default false: dry run / simulation only. Physical pump will NEVER turn on unless set to true.
PUMP_HARDWARE_ENABLED=false

# Simulation Settings
SIMULATION_INTERVAL_SECONDS=5
DEFAULT_CROP=Precision Tomato (Greenhouse)
